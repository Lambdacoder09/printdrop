{
    # Global options
    auto_https off
}

:80 {
    # Customer web
    handle /shop/* {
        reverse_proxy host.docker.internal:5173
    }

    # API & WebSockets
    handle /api/* {
        reverse_proxy host.docker.internal:3000
    }
    handle /socket.io/* {
        reverse_proxy host.docker.internal:3000
    }

    # Admin dashboard
    handle /admin/* {
        reverse_proxy host.docker.internal:5174
    }

    # Default fallback
    handle {
        reverse_proxy host.docker.internal:5173
    }
}
