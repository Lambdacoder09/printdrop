S3_BUCKET=printdrop-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_USE_SSL=false

# Realtime & CORS
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
